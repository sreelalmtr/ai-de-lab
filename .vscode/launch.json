{
  "version": "0.2.0",
  "configurations": [
    { "name": "Current file", "type": "debugpy", "request": "launch", "program": "${file}", "console": "integratedTerminal", "envFile": "${workspaceFolder}/.env" },
    { "name": "FastAPI (uvicorn)", "type": "debugpy", "request": "launch", "module": "uvicorn", "args": ["aide.api.main:app", "--reload", "--port", "8000"], "envFile": "${workspaceFolder}/.env" },
    { "name": "pytest current file", "type": "debugpy", "request": "launch", "module": "pytest", "args": ["${file}", "-x", "-s"] }
  ]
}
